# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=crypto_gateway
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# ─── Redis ───────────────────────────────────────────────────────────────────
# Provisioned but currently unused: the durable job queue runs on Postgres
# (ADR-002). Kept for a future cache/session use — do not assume it is wired.
REDIS_HOST=localhost
REDIS_PORT=6380

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# ─── Chain RPC URLs (testnet for development) ────────────────────────────────
# A chain is enabled for the worker when its RPC variable is set. At least one is
# required: the worker refuses to start with no chains configured.
ETHEREUM_RPC_URL=https://rpc.sepolia.org
BASE_RPC_URL=https://sepolia.base.org
ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# Polygon Amoy. Mumbai (rpc-mumbai.maticvigil.com) is decommissioned.
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
TRON_FULL_NODE=https://nile.trongrid.io
TRON_SOLIDITY_NODE=https://nile.trongrid.io
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# Optional per-chain confirmation depth overrides.
# ETHEREUM_CONFIRMATION_DEPTH=12
# BASE_CONFIRMATION_DEPTH=1
# ARBITRUM_CONFIRMATION_DEPTH=1
# POLYGON_CONFIRMATION_DEPTH=64
# TRON_CONFIRMATION_DEPTH=19
# SOLANA_CONFIRMATION_DEPTH=1

# ─── Worker ──────────────────────────────────────────────────────────────────
WORKER_ID=                    # defaults to worker-<pid>-<random>
WORKER_POLL_INTERVAL_MS=5000
WORKER_CONCURRENCY=4
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_BASE_MS=1000
JOB_BACKOFF_MAX_MS=300000
JOB_VISIBILITY_TIMEOUT_MS=120000
WATCHER_REFRESH_MS=30000
CONFIRMATION_CHECK_MS=15000
MAX_WATCHER_LAG_BLOCKS=100

# ─── Routing (WS3.1) ────────────────────────────────────────────────────────
# LI.FI bridge aggregator - https://docs.li.fi/
# Quote endpoints default to ~100 rpm per API key. Use a partner-portal key.
LIFI_API_KEY=
# Socket/Bungee bridge aggregator - https://docs.socket.tech/
SOCKET_API_KEY=
# Cache TTL for route quotes (seconds). Reduce to stay under provider RPM limits.
ROUTING_QUOTE_CACHE_TTL_SECONDS=30

# ─── Compliance (WS3.2) ─────────────────────────────────────────────────────
# Chainalysis KYT - requires contractual access (start procurement early)
CHAINALYSIS_API_KEY=
# TRM Labs Forensics - requires contractual access
TRM_API_KEY=
# Screening mode: 'real' (use API), 'local-lists' (OFAC/EU/UN only), 'disabled' (dev only)
SCREENING_MODE=real
# Fail mode: 'closed' (block on API failure), 'manual-review' (queue for review)
SCREENING_FAIL_MODE=closed
# Timeout for KYT API calls (ms)
KYT_TIMEOUT_MS=10000

# ─── Price Oracle (WS3.3) ───────────────────────────────────────────────────
# Oracle chain: ordered failover list (comma-separated)
# Options: coingecko, chainlink
ORACLE_CHAIN=coingecko,chainlink
# CoinGecko API key (free tier works, paid recommended for production)
COINGECKO_API_KEY=
# Maximum age of price data before rejection (seconds)
ORACLE_MAX_AGE_SECONDS=120
# Maximum allowed deviation between oracle sources (basis points)
ORACLE_MAX_DEVIATION_BPS=200

# ─── Gas Abstraction (WS3.4) ────────────────────────────────────────────────
# Paymaster provider for ERC-4337 gasless transactions
# Options: pimlico, alchemy
PAYMASTER_PROVIDER=
PAYMASTER_API_KEY=
PAYMASTER_URL=
# Daily gas sponsorship cap per merchant (USD)
GAS_SPONSORSHIP_DAILY_CAP_USD=1000

# ─── Signing (WS2) ───────────────────────────────────────────────────────────
# SIGNER_PROVIDER=local-keystore
# AWS_REGION=
# AWS_KMS_KEY_ALIAS_EVM=alias/cgw-evm-hot
# AWS_KMS_KEY_ALIAS_TRON=alias/cgw-tron-hot
# AWS_KMS_KEY_ALIAS_SOLANA=alias/cgw-solana-hot
# SIGNER_MAX_DAILY_SPEND_USD_PER_CHAIN=50000

# ─── Webhooks ────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=

# ─── Observability (WS4) ─────────────────────────────────────────────────────
# METRICS_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ─── Operations ──────────────────────────────────────────────────────────────
# EMERGENCY_PAUSE=false
