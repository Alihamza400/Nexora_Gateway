FROM base AS build

# Copy payment-intent package
COPY packages/payment-intent/package.json ./packages/payment-intent/
RUN npm install --only=production --ignore-scripts

COPY packages/payment-intent/dist ./packages/payment-intent/dist
COPY packages/payment-intent/package.json ./packages/payment-intent/

# Final stage
FROM base AS production

# Copy dependencies from build stage
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/payment-intent ./packages/payment-intent

# Set working directory
WORKDIR /app/packages/payment-intent

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3001/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Start the service
CMD ["node", "dist/index.js"]
