FROM base AS build

# Copy chain-abstraction package
COPY packages/chain-abstraction/package.json ./packages/chain-abstraction/
RUN npm install --only=production --ignore-scripts

COPY packages/chain-abstraction/dist ./packages/chain-abstraction/dist
COPY packages/chain-abstraction/package.json ./packages/chain-abstraction/

# Final stage
FROM base AS production

# Copy dependencies from build stage
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/chain-abstraction ./packages/chain-abstraction

# Set working directory
WORKDIR /app/packages/chain-abstraction

# Expose port
EXPOSE 3002

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3002/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Start the service
CMD ["node", "dist/index.js"]
